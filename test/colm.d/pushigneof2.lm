#
# Ignores pushed at the end of the input, when the parser has to back up over
# them. Sent back and scanned again, a pushed ignore must still become the
# right ignore of the token before it. Each name is printed on its own as
# well, to show which token holds the pushed ignores.
#

lex
	ignore ws /[ \n]+/
	token id /[a-z]+/
	literal `!

	# Replace the match with one space, pushed as an ignore.
	token tx /'~x'/
	{
		input->pull( match_length )
		input->push_ignore( make_token( typeid<ws>, ' ' ) )
	}

	# Parse a comment and push it as an ignore.
	token open_paren /'('/
	{
		parse_stop NC: nested_comment[ stdin ]
		input->push_ignore( NC )
	}
end

lex
	literal `( `)
	token nc_data /[^()]+/
end

def nc_item
	[nc_data]
|	[nested_comment]

def nested_comment
	[`( nc_item* `)]

# Each name is first taken as an ia. If the input ends without a !, the
# parser backs up over all of them, sending back the ignores in between, and
# takes them again as ib.
def ia
	[id]

def ib
	[id]

def start
	[ia* `!]
|	[ib*]

parse S: start[ stdin ]
if S {
	print( '[', S, ']\n' )
	for I: id in S
		print( '<', I, '>' )
	print( '\n' )
}
else
	print( 'error: ', error, '\n' )
##### IN #####
a b ~x !--noeol
##### EXP #####
[a b   !]
<a ><b   >
##### IN #####
a b ~x--noeol
##### EXP #####
[a b  ]
<a ><b  >
##### IN #####
a b ~x  --noeol
##### EXP #####
[a b    ]
<a ><b    >
##### IN #####
a b (c)--noeol
##### EXP #####
[a b (c)]
<a ><b (c)>
##### IN #####
a b (c)  --noeol
##### EXP #####
[a b (c)  ]
<a ><b (c)  >
##### IN #####
a b ~x (c (d)) ~x--noeol
##### EXP #####
[a b   (c (d))  ]
<a ><b   (c (d))  >
##### IN #####
a b (c) !--noeol
##### EXP #####
[a b (c) !]
<a ><b (c) >
