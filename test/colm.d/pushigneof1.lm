#
# An ignore that a token action pushes after a token is that token's right
# ignore, as a scanned one is. At the end of the input no token follows to
# take it as a left ignore, so without that it was dropped, along with the
# ignores scanned after it.
#

lex
	ignore ws /[ ]+/
	token id /[a-z]+/

	# Replace the match with one space, pushed as an ignore.
	token tx /'~x'/
	{
		input->pull( match_length )
		input->push_ignore( make_token( typeid<ws>, ' ' ) )
	}

	token ty /'~y'/
end

def item
	[id]
|	[ty]

def start
	[item*]

parse S: start[ stdin ]
print( '[', S, ']\n' )
##### IN #####
b ~y c--noeol
##### EXP #####
[b ~y c]
##### IN #####
b ~x c--noeol
##### EXP #####
[b   c]
##### IN #####
b    --noeol
##### EXP #####
[b    ]
##### IN #####
b ~x--noeol
##### EXP #####
[b  ]
##### IN #####
b ~x  --noeol
##### EXP #####
[b    ]
##### IN #####
b~x--noeol
##### EXP #####
[b ]
##### IN #####
b ~x ~x--noeol
##### EXP #####
[b    ]
##### IN #####
b ~x ~y--noeol
##### EXP #####
[b   ~y]
##### IN #####
~x b ~x--noeol
##### EXP #####
[  b  ]
